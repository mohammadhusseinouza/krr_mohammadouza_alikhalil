## mapping.ttl (Session 5's halifax-mapping.ttl)
##
## The Halifax GTFS tables in the operational database, mapped to the project
## graph, in R2RML (W3C Recommendation, 2012). It does what Session 2's
## convert_to_rdf.py did in Python, declaratively: every triples map below
## says "for each row of this table (or query), make this subject, with these
## properties". Morph-KGC runs it (pipeline/run.py) and Ontop runs the same
## file without materializing anything (ontop/).
##
## The vocabulary is Linked GTFS (gtfs:) plus the project's tr:NightTrip, as
## in Session 2, so Session 2's queries and Session 4's shapes work on the
## output unchanged. The IRI templates are the project naming rule
## (Session 1):  https://ul.edu.lb/kr/id/{kind}/halifax/{source key}
##
## Two deliberate differences from Session 2, both from Session 4's triage:
## 1. Times keep the text Linked GTFS asks for: 25:10:00 is "PT25H10M", built
##    in SQL (see <#StopTimes>). Session 2's graph holds "P1DT1H10M", because
##    rdflib rewrote the value; pipeline/run.py turns that rewriting off.
## 2. The feed carries the dataset metadata DCAT-AP asks for: a title, a
##    description, and its language as an IRI (see <#Feed>).
##
## Every SQL query below runs unchanged on PostgreSQL and on SQLite: only
## TRIM, SUBSTR, LENGTH, CAST, CASE, IN and || are used.

@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix geo:    <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix schema: <http://schema.org/> .
@prefix gtfs:   <http://vocab.gtfs.org/terms#> .
@prefix tr:     <https://ul.edu.lb/kr/transit#> .

########################################################################
## Stop times: one row of stop_times, one stop time (324,165 rows)
########################################################################

## A stop time has no single key: its trip and its position in the trip,
## both in the IRI. A time in the table is " 5:49:00" or "25:10:00"; the
## logical view turns it into an xsd:duration in hours since the start of
## the service day, as Linked GTFS asks, and as convert_to_rdf.py wrote it:
## PT{h}H{m}M, plus {s}S when the seconds are not 0.
<#StopTimes>
    rr:logicalTable [ rr:sqlQuery """
        SELECT trip_id, stop_id, stop_sequence,
               'PT' || CAST(SUBSTR(a, 1, LENGTH(a) - 6) AS INTEGER) || 'H'
                    || CAST(SUBSTR(a, LENGTH(a) - 4, 2) AS INTEGER) || 'M'
                    || CASE WHEN CAST(SUBSTR(a, LENGTH(a) - 1, 2) AS INTEGER) > 0
                            THEN CAST(SUBSTR(a, LENGTH(a) - 1, 2) AS INTEGER) || 'S' ELSE '' END AS arrival,
               'PT' || CAST(SUBSTR(d, 1, LENGTH(d) - 6) AS INTEGER) || 'H'
                    || CAST(SUBSTR(d, LENGTH(d) - 4, 2) AS INTEGER) || 'M'
                    || CASE WHEN CAST(SUBSTR(d, LENGTH(d) - 1, 2) AS INTEGER) > 0
                            THEN CAST(SUBSTR(d, LENGTH(d) - 1, 2) AS INTEGER) || 'S' ELSE '' END AS departure
        FROM (SELECT trip_id, stop_id, stop_sequence, TRIM(arrival_time) AS a, TRIM(departure_time) AS d
              FROM stop_times) st""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stoptime/halifax/{trip_id}/{stop_sequence}" ;
                    rr:class gtfs:StopTime ] ;

    # A link: the trip's and the stop's IRIs, built from the keys in this
    # row with the same templates their own maps use. No join needed.
    rr:predicateObjectMap [ rr:predicate gtfs:trip ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/trip/halifax/{trip_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:stop ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/stop/halifax/{stop_id}" ] ] ;

    # A value with a datatype: copy the column and say what kind of value it is.
    rr:predicateObjectMap [ rr:predicate gtfs:stopSequence ;
        rr:objectMap [ rr:column "stop_sequence" ; rr:datatype xsd:nonNegativeInteger ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:arrivalTime ;
        rr:objectMap [ rr:column "arrival" ; rr:datatype xsd:duration ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:departureTime ;
        rr:objectMap [ rr:column "departure" ; rr:datatype xsd:duration ] ] .

## Only the exceptions get a triple: 0, the GTFS default ("regular"), gets
## none. A row that has no value is left out by the query (WHERE), not by a
## NULL: Morph-KGC 2.10 turns a NULL into the text "None" in a template, and
## would write gtfs:None 324,165 times (found while building this lab).
<#Pickups>
    rr:logicalTable [ rr:sqlQuery """
        SELECT trip_id, stop_sequence,
               CASE pickup_type WHEN '1' THEN 'NotAvailable' WHEN '2' THEN 'MustPhone'
                                ELSE 'MustCoordinateWithDriver' END AS pickup
        FROM stop_times WHERE pickup_type IN ('1', '2', '3')""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stoptime/halifax/{trip_id}/{stop_sequence}" ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:pickupType ;
        rr:objectMap [ rr:template "http://vocab.gtfs.org/terms#{pickup}" ] ] .

<#DropOffs>
    rr:logicalTable [ rr:sqlQuery """
        SELECT trip_id, stop_sequence,
               CASE drop_off_type WHEN '1' THEN 'NotAvailable' WHEN '2' THEN 'MustPhone'
                                  ELSE 'MustCoordinateWithDriver' END AS drop_off
        FROM stop_times WHERE drop_off_type IN ('1', '2', '3')""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stoptime/halifax/{trip_id}/{stop_sequence}" ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:dropOffType ;
        rr:objectMap [ rr:template "http://vocab.gtfs.org/terms#{drop_off}" ] ] .

########################################################################
## Trips: one row of trips, one trip
########################################################################

<#Trips>
    rr:logicalTable [ rr:sqlQuery """
        SELECT trip_id, route_id, service_id, trip_headsign, block_id, shape_id,
               CASE WHEN direction_id = '1' THEN 'true' ELSE 'false' END AS direction
        FROM trips""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/trip/halifax/{trip_id}" ] ;
    rr:predicateObjectMap [ rr:predicate dct:identifier ;
        rr:objectMap [ rr:column "trip_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:route ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/route/halifax/{route_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:service ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/service/halifax/{service_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:headsign ;
        rr:objectMap [ rr:column "trip_headsign" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:direction ;
        rr:objectMap [ rr:column "direction" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:block ;
        rr:objectMap [ rr:column "block_id" ; rr:datatype xsd:nonNegativeInteger ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:shape ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/shape/halifax/{shape_id}" ] ] .

## The class depends on other rows: a trip is a night trip when any of its
## stop times reaches 24:00:00, and is then typed tr:NightTrip only, as in
## Session 2. Two small maps, one per class. The IN list is computed once.
<#NightTrips>
    rr:logicalTable [ rr:sqlQuery """
        SELECT trip_id FROM trips WHERE trip_id IN (
            SELECT trip_id FROM stop_times
            WHERE CAST(SUBSTR(TRIM(arrival_time), 1, LENGTH(TRIM(arrival_time)) - 6) AS INTEGER) >= 24
               OR CAST(SUBSTR(TRIM(departure_time), 1, LENGTH(TRIM(departure_time)) - 6) AS INTEGER) >= 24)""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/trip/halifax/{trip_id}" ;
                    rr:class tr:NightTrip ] .

<#DayTrips>
    rr:logicalTable [ rr:sqlQuery """
        SELECT trip_id FROM trips WHERE trip_id NOT IN (
            SELECT trip_id FROM stop_times
            WHERE CAST(SUBSTR(TRIM(arrival_time), 1, LENGTH(TRIM(arrival_time)) - 6) AS INTEGER) >= 24
               OR CAST(SUBSTR(TRIM(departure_time), 1, LENGTH(TRIM(departure_time)) - 6) AS INTEGER) >= 24)""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/trip/halifax/{trip_id}" ;
                    rr:class gtfs:Trip ] .

########################################################################
## Routes, the agency and the feed
########################################################################

## route_type is a GTFS code; Linked GTFS names each code with an individual
## (3 is gtfs:Bus, 4 is gtfs:Ferry). The view turns the code into the name.
<#Routes>
    rr:logicalTable [ rr:sqlQuery """
        SELECT route_id, agency_id, route_short_name, route_long_name, route_color, route_text_color,
               CASE route_type WHEN '0' THEN 'LightRail' WHEN '1' THEN 'Subway' WHEN '2' THEN 'Rail'
                               WHEN '3' THEN 'Bus' WHEN '4' THEN 'Ferry' WHEN '5' THEN 'CableCar'
                               WHEN '6' THEN 'Gondola' WHEN '7' THEN 'Funicular' END AS route_type_name
        FROM routes""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/route/halifax/{route_id}" ;
                    rr:class gtfs:Route ] ;
    rr:predicateObjectMap [ rr:predicate dct:identifier ;
        rr:objectMap [ rr:column "route_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:shortName ;
        rr:objectMap [ rr:column "route_short_name" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:longName ;
        rr:objectMap [ rr:column "route_long_name" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:routeType ;
        rr:objectMap [ rr:template "http://vocab.gtfs.org/terms#{route_type_name}" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:agency ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/agency/halifax/{agency_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:color ;
        rr:objectMap [ rr:column "route_color" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:textColor ;
        rr:objectMap [ rr:column "route_text_color" ] ] .

<#Agency>
    rr:logicalTable [ rr:tableName "agency" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/agency/halifax/{agency_id}" ;
                    rr:class gtfs:Agency ] ;
    rr:predicateObjectMap [ rr:predicate dct:identifier ;
        rr:objectMap [ rr:column "agency_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate foaf:name ;
        rr:objectMap [ rr:column "agency_name" ] ] ;
    # A column that already holds an IRI: say so with rr:termType rr:IRI.
    rr:predicateObjectMap [ rr:predicate foaf:page ;
        rr:objectMap [ rr:column "agency_url" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:fareUrl ;
        rr:objectMap [ rr:column "agency_fare_url" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate foaf:phone ;
        rr:objectMap [ rr:template "tel:{agency_phone}" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:timeZone ;
        rr:objectMap [ rr:column "agency_timezone" ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:language ;
        rr:objectMap [ rr:column "agency_lang" ] ] .

## The feed. Its title and description are written from feed_info's own
## columns; its language is the EU language authority's IRI, as DCAT-AP asks
## (Session 4, fetch_dcatap.py), instead of Session 2's text "en".
<#Feed>
    rr:logicalTable [ rr:sqlQuery """
        SELECT feed_version, feed_lang,
               feed_publisher_name || ' GTFS feed, version ' || feed_version AS title,
               'Timetable of ' || feed_publisher_name || ', valid from '
                   || SUBSTR(feed_start_date, 1, 4) || '-' || SUBSTR(feed_start_date, 5, 2) || '-'
                   || SUBSTR(feed_start_date, 7, 2) || ' to '
                   || SUBSTR(feed_end_date, 1, 4) || '-' || SUBSTR(feed_end_date, 5, 2) || '-'
                   || SUBSTR(feed_end_date, 7, 2) || '.' AS description,
               CASE feed_lang WHEN 'en' THEN 'ENG' WHEN 'fr' THEN 'FRA' END AS language
        FROM feed_info""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/feed/halifax/{feed_version}" ;
                    rr:class gtfs:Feed ] ;
    rr:predicateObjectMap [ rr:predicate schema:version ;
        rr:objectMap [ rr:column "feed_version" ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:title ;
        rr:objectMap [ rr:column "title" ; rr:language "en" ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:description ;
        rr:objectMap [ rr:column "description" ; rr:language "en" ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:language ;
        rr:objectMap [ rr:template "http://publications.europa.eu/resource/authority/language/{language}" ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:temporal ;
        rr:objectMap [ rr:template "feed-period-{feed_version}" ; rr:termType rr:BlankNode ] ] .

## The feed's period has no key of its own: a blank node, as in Session 2.
<#FeedPeriod>
    rr:logicalTable [ rr:sqlQuery """
        SELECT feed_version,
               SUBSTR(feed_start_date, 1, 4) || '-' || SUBSTR(feed_start_date, 5, 2) || '-' || SUBSTR(feed_start_date, 7, 2) AS start_day,
               SUBSTR(feed_end_date, 1, 4) || '-' || SUBSTR(feed_end_date, 5, 2) || '-' || SUBSTR(feed_end_date, 7, 2) AS end_day
        FROM feed_info""" ] ;
    rr:subjectMap [ rr:template "feed-period-{feed_version}" ; rr:termType rr:BlankNode ] ;
    rr:predicateObjectMap [ rr:predicate schema:startDate ;
        rr:objectMap [ rr:column "start_day" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate schema:endDate ;
        rr:objectMap [ rr:column "end_day" ; rr:datatype xsd:date ] ] .

## The publisher is named, not keyed: it is the agency only because the
## names match. A join says exactly that, and a row that does not match
## gives no triple.
<#FeedPublisher>
    rr:logicalTable [ rr:sqlQuery """
        SELECT f.feed_version, a.agency_id FROM feed_info f
        JOIN agency a ON f.feed_publisher_name = a.agency_name""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/feed/halifax/{feed_version}" ] ;
    rr:predicateObjectMap [ rr:predicate dct:publisher ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/agency/halifax/{agency_id}" ] ] .

########################################################################
## Stops and stations: one table, two kinds of thing (Session 1, check 4)
########################################################################

## The columns every row of stops.txt has.
<#StopsAndStations>
    rr:logicalTable [ rr:tableName "stops" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stop/halifax/{stop_id}" ] ;
    rr:predicateObjectMap [ rr:predicate dct:identifier ;
        rr:objectMap [ rr:column "stop_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:code ;
        rr:objectMap [ rr:column "stop_code" ] ] ;
    rr:predicateObjectMap [ rr:predicate foaf:name ;
        rr:objectMap [ rr:column "stop_name" ] ] ;
    rr:predicateObjectMap [ rr:predicate geo:lat ;
        rr:objectMap [ rr:column "stop_lat" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate geo:long ;
        rr:objectMap [ rr:column "stop_lon" ; rr:datatype xsd:decimal ] ] .

## The columns only some rows fill: the query keeps those rows (see
## <#Pickups> for why a WHERE, not a NULL).
<#StopDescriptions>
    rr:logicalTable [ rr:sqlQuery """SELECT stop_id, stop_desc FROM stops WHERE stop_desc <> ''""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stop/halifax/{stop_id}" ] ;
    rr:predicateObjectMap [ rr:predicate dct:description ;
        rr:objectMap [ rr:column "stop_desc" ] ] .

<#ParentStations>
    rr:logicalTable [ rr:sqlQuery """SELECT stop_id, parent_station FROM stops WHERE parent_station <> ''""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stop/halifax/{stop_id}" ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:parentStation ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/stop/halifax/{parent_station}" ] ] .

<#Stations>
    rr:logicalTable [ rr:sqlQuery """SELECT stop_id FROM stops WHERE location_type = '1'""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stop/halifax/{stop_id}" ;
                    rr:class gtfs:Station ] .

<#Stops>
    rr:logicalTable [ rr:sqlQuery """SELECT stop_id FROM stops WHERE location_type <> '1'""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stop/halifax/{stop_id}" ;
                    rr:class gtfs:Stop ] .

########################################################################
## Services and their rules: calendar and calendar_dates
########################################################################

## Every service, from either table: two services exist only in
## calendar_dates.txt (Session 4's triage).
<#Services>
    rr:logicalTable [ rr:sqlQuery """
        SELECT service_id FROM calendar
        UNION
        SELECT service_id FROM calendar_dates""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/service/halifax/{service_id}" ;
                    rr:class gtfs:Service ] .

## A row of calendar.txt: the service's weekly rule, keyed by the service.
<#CalendarRules>
    rr:logicalTable [ rr:sqlQuery """
        SELECT service_id,
               CASE WHEN monday = '1' THEN 'true' ELSE 'false' END AS mon,
               CASE WHEN tuesday = '1' THEN 'true' ELSE 'false' END AS tue,
               CASE WHEN wednesday = '1' THEN 'true' ELSE 'false' END AS wed,
               CASE WHEN thursday = '1' THEN 'true' ELSE 'false' END AS thu,
               CASE WHEN friday = '1' THEN 'true' ELSE 'false' END AS fri,
               CASE WHEN saturday = '1' THEN 'true' ELSE 'false' END AS sat,
               CASE WHEN sunday = '1' THEN 'true' ELSE 'false' END AS sun
        FROM calendar""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/calendarrule/halifax/{service_id}" ;
                    rr:class gtfs:CalendarRule ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:monday ; rr:objectMap [ rr:column "mon" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:tuesday ; rr:objectMap [ rr:column "tue" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:wednesday ; rr:objectMap [ rr:column "wed" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:thursday ; rr:objectMap [ rr:column "thu" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:friday ; rr:objectMap [ rr:column "fri" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:saturday ; rr:objectMap [ rr:column "sat" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:sunday ; rr:objectMap [ rr:column "sun" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:temporal ;
        rr:objectMap [ rr:template "calendar-period-{service_id}" ; rr:termType rr:BlankNode ] ] .

<#CalendarPeriods>
    rr:logicalTable [ rr:sqlQuery """
        SELECT service_id,
               SUBSTR(start_date, 1, 4) || '-' || SUBSTR(start_date, 5, 2) || '-' || SUBSTR(start_date, 7, 2) AS start_day,
               SUBSTR(end_date, 1, 4) || '-' || SUBSTR(end_date, 5, 2) || '-' || SUBSTR(end_date, 7, 2) AS end_day
        FROM calendar""" ] ;
    rr:subjectMap [ rr:template "calendar-period-{service_id}" ; rr:termType rr:BlankNode ] ;
    rr:predicateObjectMap [ rr:predicate schema:startDate ;
        rr:objectMap [ rr:column "start_day" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate schema:endDate ;
        rr:objectMap [ rr:column "end_day" ; rr:datatype xsd:date ] ] .

<#ServiceWeeklyRule>
    rr:logicalTable [ rr:tableName "calendar" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/service/halifax/{service_id}" ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:serviceRule ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/calendarrule/halifax/{service_id}" ] ] .

## A row of calendar_dates.txt: one date added to or removed from a service,
## keyed by the service and the date together.
<#CalendarDateRules>
    rr:logicalTable [ rr:sqlQuery """
        SELECT service_id, date,
               SUBSTR(date, 1, 4) || '-' || SUBSTR(date, 5, 2) || '-' || SUBSTR(date, 7, 2) AS day,
               CASE WHEN exception_type = '1' THEN 'true' ELSE 'false' END AS added
        FROM calendar_dates""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/calendardaterule/halifax/{service_id}/{date}" ;
                    rr:class gtfs:CalendarDateRule ] ;
    rr:predicateObjectMap [ rr:predicate dct:date ;
        rr:objectMap [ rr:column "day" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:dateAddition ;
        rr:objectMap [ rr:column "added" ; rr:datatype xsd:boolean ] ] .

<#ServiceDateRule>
    rr:logicalTable [ rr:tableName "calendar_dates" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/service/halifax/{service_id}" ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:serviceRule ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/calendardaterule/halifax/{service_id}/{date}" ] ] .
