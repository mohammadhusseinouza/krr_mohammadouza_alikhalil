## ontology-v0.ttl: the FIRST DRAFT, kept as evidence. It is not deployed.
##
## The reasoner finds two impossible classes in it (reasoner-run.txt,
## explanations/); ontology.ttl is the release that fixes both. Below, the
## draft's own header from the Session 3 lab, unchanged.
##
## This file contains real modelling errors, on purpose. They are the
## errors the reasoner finds in the lab. Do not try to spot them by
## reading: run the reasoner first, as the lab README (Part A) shows,
## and let it tell you. The fixed version is tr-extension-reference.ttl;
## open it only after both red classes are found and explained.
##
## Ontology IRI differs from the reference file on purpose, so both can
## be open in Protege at the same time without clashing.

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gtfs: <http://vocab.gtfs.org/terms#> .
@prefix tr:   <https://ul.edu.lb/kr/transit#> .

<https://ul.edu.lb/kr/transit/v0> a owl:Ontology ;
    rdfs:label "UL Knowledge Representation project: Halifax transit ontology, v0 (lab starting point)" ;
    owl:imports <http://vocab.gtfs.org/terms#> .

## Two annotation properties every class below uses. Declared here once
## so the reasoner and ROBOT both recognise them as annotations, not as
## undeclared punning.

tr:answersCQ a owl:AnnotationProperty ;
    rdfs:label "answers competency question" ;
    rdfs:comment "The competency question (see competency_questions.md) this class exists to answer. A class with none has not earned its place, per the lecture's own rule." .

tr:profile a owl:AnnotationProperty ;
    rdfs:label "intended OWL profile" ;
    rdfs:comment "EL or DL: which profile this class was written for. The course's working rule (lecture slide 'Speed against expressiveness'): a class stays EL as long as it only uses conjunction, someValuesFrom and hasValue; allValuesFrom, cardinality, complementOf or inverseOf push it to DL." .

########################################################################
## What this file adds to Linked GTFS before any competency question
########################################################################

## Linked GTFS is an RDFS vocabulary: it calls every property an
## rdf:Property. OWL needs to know whether a property links two things
## or a thing and a value, so the properties this file uses are declared
## here. A declaration adds no meaning beyond that.

gtfs:route a owl:ObjectProperty .
gtfs:routeType a owl:ObjectProperty .
gtfs:trip a owl:ObjectProperty .
gtfs:stop a owl:ObjectProperty .
gtfs:service a owl:ObjectProperty .
gtfs:serviceRule a owl:ObjectProperty .
gtfs:parentStation a owl:ObjectProperty .
gtfs:dateAddition a owl:DatatypeProperty .

## One row of each GTFS table is one kind of thing, and a thing of one
## kind is never a thing of another: a route is not a trip, a stop is not
## a fare rule. GTFS says so by giving each its own table and its own id.
## Linked GTFS never says it, so this file does. It is what lets a
## reasoner notice a definition that mixes two kinds up.

[] a owl:AllDisjointClasses ;
    owl:members ( gtfs:Agency gtfs:Feed gtfs:Route gtfs:Trip gtfs:StopTime
                  gtfs:Stop gtfs:Station gtfs:Service gtfs:ServiceRule
                  gtfs:FareRule gtfs:Shape ) .

########################################################################
## CQ 1. Which trips run past midnight, and on which routes?
########################################################################

## The same class Session 2's converter already writes. It stays a
## primitive class (SubClassOf): "past midnight" means a stop time of
## 24:00:00 or later, a comparison of durations OWL cannot express, so
## the converter decides it and the ontology only places it.

tr:NightTrip a owl:Class ;
    rdfs:subClassOf gtfs:Trip ;
    rdfs:label "Night trip"@en ;
    skos:definition "A trip with at least one stop time at 24:00:00 or later, that is, after midnight of its service day."@en ;
    tr:profile "EL" ;
    tr:answersCQ "Which trips run past midnight, and on which routes?" .

## CancelledTrip is deliberately left without a tr:answersCQ. Run the
## "classes with no competency question" query in
## competency_questions.md against this file and this class is the one
## it finds. Per the lecture's rule: question whether it earns its place.
## It stays in this file on purpose, as the exercise; discuss it rather
## than deleting it.
tr:CancelledTrip a owl:Class ;
    rdfs:subClassOf gtfs:Trip ;
    rdfs:label "Cancelled trip"@en ;
    skos:definition "A scheduled trip withdrawn from service on a day it was due to run."@en ;
    tr:profile "EL" .

########################################################################
## CQ 2. Which routes are ferry routes, and which are bus routes?
########################################################################

## Defined classes (EquivalentTo): a route IS a ferry route exactly when
## its route type is gtfs:Ferry. gtfs:Ferry and gtfs:Bus are individuals
## Linked GTFS publishes, the values of routes.txt's route_type 4 and 3.

tr:FerryRoute a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            gtfs:Route
            [ a owl:Restriction ; owl:onProperty gtfs:routeType ; owl:hasValue gtfs:Ferry ]
        )
    ] ;
    rdfs:label "Ferry route"@en ;
    skos:definition "A route whose vehicles are ferries (GTFS route_type 4)."@en ;
    tr:profile "EL" ;
    tr:answersCQ "Which routes are ferry routes, and which are bus routes?" .

tr:BusRoute a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            gtfs:Route
            [ a owl:Restriction ; owl:onProperty gtfs:routeType ; owl:hasValue gtfs:Bus ]
        )
    ] ;
    rdfs:label "Bus route"@en ;
    skos:definition "A route whose vehicles are buses (GTFS route_type 3)."@en ;
    tr:profile "EL" ;
    tr:answersCQ "Which routes are ferry routes, and which are bus routes?" .

########################################################################
## CQ 3. Which trips cross the harbour by ferry, and when do they run?
########################################################################

## Reuses gtfs:route exactly as the data does: a trip, linked to the
## route it runs on. Chains into CQ 2's tr:FerryRoute rather than
## restating what a ferry is.

tr:FerryTrip a owl:Class ;
    rdfs:subClassOf gtfs:Trip ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty gtfs:route ;
        owl:someValuesFrom tr:FerryRoute
    ] ;
    rdfs:label "Ferry trip"@en ;
    skos:definition "A trip that runs on a ferry route."@en ;
    tr:profile "EL" ;
    tr:answersCQ "Which trips cross the harbour by ferry, and when do they run?" .

########################################################################
## CQ 4. If route R is cut, which stops lose their only route?
########################################################################

## Linked GTFS already has a property called gtfs:route, the word this
## question uses, so it is reused directly for "this stop is served by
## this route". Nothing new is needed for the relationship itself, only
## for "the only one", a cardinality fact GTFS does not state for you.

tr:SingleRouteStop a owl:Class ;
    rdfs:subClassOf gtfs:Stop ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty gtfs:route ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gtfs:Route
    ] ;
    rdfs:label "Single-route stop"@en ;
    skos:definition "A stop served by exactly one route, so cutting that route leaves it with no service."@en ;
    tr:profile "DL" ;
    tr:answersCQ "If route R is cut, which stops lose their only route?" .

########################################################################
## CQ 5. Where can a rider change from one route to another?
########################################################################

## "Two or more" is a cardinality fact again, so this one is DL for the
## same reason CQ 4 is. The relationship is this project's own pair of
## properties: tr:servesStop is the triple Session 2's Q7 CONSTRUCT
## built from the stop times, and tr:servedByRoute reads it the other
## way, from the stop.

tr:TransferStop a owl:Class ;
    rdfs:subClassOf gtfs:Stop ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty tr:servedByRoute ;
        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gtfs:Route
    ] ;
    rdfs:label "Transfer stop"@en ;
    skos:definition "A stop served by two or more routes, where a rider can change from one to another."@en ;
    tr:profile "DL" ;
    tr:answersCQ "Where can a rider change from one route to another?" .

tr:servesStop a owl:ObjectProperty ;
    rdfs:label "serves stop"@en ;
    rdfs:comment "Some trip of this route calls at this stop. Not in the GTFS tables directly: Session 2's Q7 CONSTRUCT derives it from the stop times."@en ;
    rdfs:domain gtfs:Route ;
    rdfs:range gtfs:Stop .

tr:servedByRoute a owl:ObjectProperty ;
    rdfs:label "served by route"@en ;
    rdfs:comment "This stop is called at by some trip of this route; tr:servesStop read from the stop's side."@en ;
    owl:inverseOf tr:servesStop ;
    rdfs:domain gtfs:Stop ;
    rdfs:range gtfs:Route .

########################################################################
## CQ 6. On a given date, which services are cancelled, and which run
## in their place?
########################################################################

## Session 2's Q6: on Thanksgiving, 12 October 2026, calendar_dates.txt
## removes the weekday services and adds the Sunday ones. A calendar
## date rule with gtfs:dateAddition false is a removal, true an addition.
## Defined classes, so the reasoner sorts the rules by itself.
## DL, not EL, although they use only an intersection and a hasValue:
## the value is an xsd:boolean, and xsd:boolean is not one of the
## datatypes the EL profile allows. ELK leaves these two classes empty;
## HermiT fills them.

tr:ServiceRemoval a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            gtfs:CalendarDateRule
            [ a owl:Restriction ; owl:onProperty gtfs:dateAddition ; owl:hasValue false ]
        )
    ] ;
    rdfs:label "Service removal"@en ;
    skos:definition "A calendar date rule that takes a service off one date (GTFS exception_type 2)."@en ;
    tr:profile "DL" ;
    tr:answersCQ "On a given date, which services are cancelled, and which run in their place?" .

tr:ServiceAddition a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            gtfs:CalendarDateRule
            [ a owl:Restriction ; owl:onProperty gtfs:dateAddition ; owl:hasValue true ]
        )
    ] ;
    rdfs:label "Service addition"@en ;
    skos:definition "A calendar date rule that puts a service on one date (GTFS exception_type 1)."@en ;
    tr:profile "DL" ;
    tr:answersCQ "On a given date, which services are cancelled, and which run in their place?" .
